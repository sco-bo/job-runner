<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Onboarding — Step 1: Basic Profile</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231e293b'/><rect x='8' y='13' width='16' height='11' rx='2' fill='%2322c55e'/><rect x='12' y='10' width='8' height='5' rx='1.5' fill='none' stroke='%2322c55e' stroke-width='2'/><rect x='15' y='17' width='2' height='3' rx='1' fill='%231e293b'/></svg>">
<style>
  :root {
    --blue: #3b82f6; --gray: #6b7280; --light: #f9fafb;
    --border: #e5e7eb; --text: #111827; --radius: 8px;
    --green: #22c55e; --red: #ef4444;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
         background: var(--light); color: var(--text); font-size: 14px; }

  .header { background: #1e293b; color: white; padding: 12px 20px;
            display: flex; align-items: center; gap: 16px; }
  .header a { color: #94a3b8; text-decoration: none; font-size: 13px; }
  .header a:hover { color: white; }
  .header h1 { font-size: 15px; font-weight: 600; }

  .main { max-width: 720px; margin: 0 auto; padding: 24px 20px; }

  .step-indicator { display: flex; gap: 8px; margin-bottom: 24px; align-items: center; }
  .step-dot { width: 28px; height: 28px; border-radius: 50%;
              display: flex; align-items: center; justify-content: center;
              font-size: 12px; font-weight: 600; }
  .step-dot.active { background: #1e293b; color: white; }
  .step-dot.done { background: var(--green); color: white; }
  .step-dot.pending { background: var(--border); color: var(--gray); }
  .step-line { width: 24px; height: 2px; background: var(--border); }

  h2 { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
  p.sub { font-size: 13px; color: var(--gray); margin-bottom: 20px; }

  .form-section { background: white; border: 1px solid var(--border);
                  border-radius: var(--radius); padding: 20px; margin-bottom: 16px; }
  .form-section h3 { font-size: 13px; font-weight: 600; color: var(--gray);
                     text-transform: uppercase; letter-spacing: .5px; margin-bottom: 12px; }

  .field { margin-bottom: 14px; }
  .field:last-child { margin-bottom: 0; }
  .field label { display: block; font-size: 12px; font-weight: 600;
                 color: #374151; margin-bottom: 4px; }
  .field input, .field textarea, .field select { width: 100%; padding: 8px 10px;
    border: 1px solid var(--border); border-radius: 4px; font-size: 13px;
    font-family: inherit; outline: none; }
  .field input:focus, .field textarea:focus { border-color: var(--blue); }
  .field textarea { min-height: 60px; resize: vertical; }
  .field .hint { font-size: 11px; color: var(--gray); margin-top: 2px; }
  .field .error { font-size: 11px; color: var(--red); margin-top: 2px; }
  .field-row { display: flex; gap: 12px; }
  .field-row .field { flex: 1; }

  .actions { display: flex; gap: 12px; margin-top: 20px; }
  .btn-primary { background: #1e293b; color: white; border: none; border-radius: 6px;
                 padding: 10px 24px; font-size: 14px; font-weight: 500; cursor: pointer; }
  .btn-primary:hover { background: #334155; }
  .btn-secondary { background: white; color: #374151; border: 1px solid var(--border);
                   border-radius: 6px; padding: 10px 24px; font-size: 14px;
                   font-weight: 500; cursor: pointer; }
  .btn-secondary:hover { background: #f9fafb; }

  .error-banner { background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px;
                  padding: 12px 16px; margin-bottom: 16px; font-size: 13px; color: #991b1b; }
  .error-banner ul { margin: 4px 0 0 16px; }
</style>
</head>
<body>

<div class="header">
  <a href="/">← Back to Dashboard</a>
  <h1>Onboarding — Basic Profile</h1>
</div>

<div class="main">

  <div class="step-indicator">
    <span class="step-dot active">1</span>
    <span class="step-line"></span>
    <span class="step-dot pending">2</span>
    <span class="step-line"></span>
    <span class="step-dot pending">3</span>
    <span class="step-line"></span>
    <span class="step-dot pending">4</span>
  </div>

  <h2>Tell us about yourself</h2>
  <p class="sub">This information customizes your job search and powers the prompts generated by the tool.</p>

  {% if errors %}
  <div class="error-banner">
    Please fix the following:
    <ul>
    {% for err in errors %}
      <li>{{ err }}</li>
    {% endfor %}
    </ul>
  </div>
  {% endif %}

  <form method="POST" action="/onboard?step=1">

    <div class="form-section">
      <h3>About You</h3>
      <div class="field">
        <label for="location">Location</label>
        <input type="text" id="location" name="location" value="{{ data.get('location', '') }}" placeholder="e.g. Denver, CO">
      </div>
      <div class="field">
        <label for="linkedin">LinkedIn URL</label>
        <input type="url" id="linkedin" name="linkedin" value="{{ data.get('linkedin', '') }}" placeholder="https://linkedin.com/in/yourhandle">
      </div>
      <div class="field">
        <label for="role_description">Role description</label>
        <input type="text" id="role_description" name="role_description" value="{{ data.get('role_description', '') }}" placeholder="'Software Engineer', 'Product Manager', 'Teacher', etc.">
        <div class="hint">This will be used for resume tailoring prompts. "I'm [role] applying for the role below."</div>
      </div>
    </div>

    <div class="form-section">
      <h3>Target Job Preferences</h3>
      <div class="field">
        <label for="target_titles">Target job titles (one per line)</label>
        <textarea id="target_titles" name="target_titles" placeholder="Product Manager&#10;Senior Product Manager&#10;Group Product Manager">{{ data.get('target_titles', '') }}</textarea>
        <div class="hint">Used to match job listings if the exact title varies. List common variations of the roles you're targeting.</div>
      </div>
      <div class="field">
        <label for="years_experience">Years of experience</label>
        <input type="number" id="years_experience" name="years_experience"
               value="{{ data.get('years_experience', '0') }}" min="0">
      </div>
      <div class="field-row">
        <div class="field">
          <label for="salary_min">Min salary ($)</label>
          <input type="number" id="salary_min" name="salary_min"
                 value="{{ data.get('salary_min', '') }}" min="0" step="10000">
        </div>
        <div class="field">
          <label for="salary_max">Max salary ($)</label>
          <input type="number" id="salary_max" name="salary_max"
                 value="{{ data.get('salary_max', '') }}" min="0" step="10000">
        </div>
      </div>
      <div class="field">
        <label for="remote">Remote preference</label>
        <select id="remote" name="preferred_remote">
          <option value="true" {{ 'selected' if data.get('preferred_remote') != false else '' }}>Prefer remote</option>
          <option value="false" {{ 'selected' if data.get('preferred_remote') == false else '' }}>Open to on-site</option>
        </select>
      </div>
      <div class="field">
        <label for="preferred_locations">Preferred locations (one per line)</label>
        <textarea id="preferred_locations" name="preferred_locations">{{ data.get('preferred_locations', '') }}</textarea>
      </div>
      <div class="field">
        <label for="avoid_keywords">Avoid keywords (one per line — jobs mentioning these will rank lower)</label>
        <textarea id="avoid_keywords" name="avoid_keywords">{{ data.get('avoid_keywords', '') }}</textarea>
        <div class="hint">e.g. "must be on-site", "relocation required"</div>
      </div>
      <div class="field">
        <label for="exclude_title_keywords">Exclude title keywords (one per line — jobs with these in title are hidden)</label>
        <textarea id="exclude_title_keywords" name="exclude_title_keywords">{{ data.get('exclude_title_keywords', '') }}</textarea>
        <div class="hint">e.g. "director", "principal", "associate"</div>
      </div>
    </div>

    <div class="form-section">
      <h3>Industries</h3>
      <p style="font-size:12px;color:var(--gray);margin-bottom:10px;">
        Select the industries you target. Leave blank if not sure — the LLM can suggest these in the next step.
      </p>
      <div class="field">
        <label for="industries">Industries (one per line, max 8)</label>
        <textarea id="industries" name="industries">{{ data.get('industries', '') }}</textarea>
      </div>
    </div>

    <div class="actions">
      <button type="submit" class="btn-primary">Save & Continue →</button>
    </div>

  </form>

</div>

</body>
</html>