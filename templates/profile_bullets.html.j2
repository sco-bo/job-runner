<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profile — Edit Bullets</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231e293b'/><rect x='8' y='13' width='16' height='11' rx='2' fill='%2322c55e'/><rect x='12' y='10' width='8' height='5' rx='1.5' fill='none' stroke='%2322c55e' stroke-width='2'/><rect x='15' y='17' width='2' height='3' rx='1' fill='%231e293b'/></svg>">
<style>
  :root { --blue: #3b82f6; --gray: #6b7280; --light: #f9fafb;
           --border: #e5e7eb; --text: #111827; --radius: 8px; --red: #ef4444; --green: #22c55e; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
         background: var(--light); color: var(--text); font-size: 14px; }
  .header { background: #1e293b; color: white; padding: 12px 20px;
            display: flex; align-items: center; gap: 16px; }
  .header a { color: #94a3b8; text-decoration: none; font-size: 13px; }
  .header a:hover { color: white; }
  .header h1 { font-size: 15px; font-weight: 600; }
  .main { max-width: 800px; margin: 0 auto; padding: 24px 20px; }
  h2 { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
  p.sub { font-size: 13px; color: var(--gray); margin-bottom: 20px; }

  .bullet-card { background: white; border: 1px solid var(--border);
                 border-radius: var(--radius); padding: 16px 20px; margin-bottom: 10px; }
  .bullet-card .bullet-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .bullet-card .bullet-id { font-size: 11px; color: #9ca3af; font-family: monospace; }
  .field { margin-bottom: 8px; }
  .field label { display: block; font-size: 11px; font-weight: 600;
                 color: #374151; margin-bottom: 2px; }
  .field input, .field textarea, .field select { width: 100%; padding: 6px 8px;
    border: 1px solid var(--border); border-radius: 4px; font-size: 13px;
    font-family: inherit; outline: none; }
  .field input:focus, .field textarea:focus { border-color: var(--blue); }
  .field textarea { min-height: 40px; resize: vertical; font-size: 12px; }
  .field-row { display: flex; gap: 8px; }
  .field-row .field { flex: 1; }
  .tag { display: inline-block; background: #f3f4f6; color: #374151; font-size: 11px;
         padding: 1px 6px; border-radius: 3px; margin: 2px; cursor: pointer; }
  .tag.selected { background: #dbeafe; color: #1e40af; }

  .add-btn { background: none; border: 1px dashed var(--border); color: var(--blue);
             border-radius: 6px; padding: 10px 20px; font-size: 13px; cursor: pointer;
             width: 100%; margin-bottom: 16px; }
  .add-btn:hover { background: #f9fafb; }

  .success-banner { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px;
                    padding: 10px 16px; margin-bottom: 16px; font-size: 13px; color: #166534; }
  .actions { display: flex; gap: 12px; margin-top: 20px; }
  .btn-primary { background: #1e293b; color: white; border: none; border-radius: 6px;
                 padding: 10px 24px; font-size: 14px; font-weight: 500; cursor: pointer; }
  .btn-primary:hover { background: #334155; }
  .btn-secondary { background: white; color: #374151; border: 1px solid var(--border);
                   border-radius: 6px; padding: 10px 24px; font-size: 14px;
                   font-weight: 500; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn-secondary:hover { background: #f9fafb; }
  .btn-danger { background: none; border: 1px solid #fecaca; color: #991b1b;
                border-radius: 4px; padding: 4px 10px; font-size: 11px; cursor: pointer; }
  .btn-danger:hover { background: #fef2f2; }
</style>
</head>
<body>

<div class="header">
  <a href="/profile">← Back to Profile</a>
  <h1>Edit Resume Bullets</h1>
</div>

<div class="main">

  <h2>Resume Bullets</h2>
  <p class="sub">
    Each bullet should describe a specific achievement with measurable impact.
    Available themes: {% for t in all_themes %}<strong>{{ t }}</strong>{% if not loop.last %}, {% endif %}{% endfor %}
  </p>

  {% if saved %}
  <div class="success-banner">Saved successfully ✓</div>
  {% endif %}

  <form method="POST" action="/profile/bullets" id="bullet-form">

    <div id="bullet-list">
    {% for bullet in bullets %}
      <div class="bullet-card" data-index="{{ loop.index0 }}">
        <div class="bullet-header">
          <span class="bullet-id">{{ bullet.id }}</span>
          <button type="button" class="btn-danger" onclick="removeBullet(this)">Remove</button>
        </div>
        <div class="field">
          <input type="hidden" name="id_{{ loop.index0 }}" value="{{ bullet.id }}">
          <textarea name="text_{{ loop.index0 }}" rows="2" required>{{ bullet.text }}</textarea>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Strength</label>
            <select name="strength_{{ loop.index0 }}">
              <option value="high" {{ 'selected' if bullet.strength == 'high' else '' }}>High</option>
              <option value="medium" {{ 'selected' if bullet.strength == 'medium' else '' }}>Medium</option>
              <option value="supporting" {{ 'selected' if bullet.strength == 'supporting' else '' }}>Supporting</option>
            </select>
          </div>
          <div class="field">
            <label>Themes (comma-separated)</label>
            <input type="text" name="themes_{{ loop.index0 }}" value="{{ bullet.themes | join(', ') }}" placeholder="e.g. data, api">
          </div>
        </div>
      </div>
    {% endfor %}
    </div>

    <button type="button" class="add-btn" onclick="addBullet()">+ Add a bullet</button>
    <input type="hidden" name="bullet_count" id="bullet_count" value="{{ bullets|length }}">
    <input type="hidden" name="all_themes" id="hidden_themes" value="{{ available_themes }}">

    <div class="actions">
      <a href="/profile" class="btn-secondary">Cancel</a>
      <button type="submit" class="btn-primary">Save changes</button>
    </div>

  </form>

</div>

<script>
let bulletIndex = {{ bullets|length }};
const allThemes = {{ available_themes | tojson }};

function addBullet() {
  bulletIndex++;
  const container = document.getElementById('bullet-list');
  const div = document.createElement('div');
  div.className = 'bullet-card';
  div.innerHTML = `
    <div class="bullet-header">
      <span class="bullet-id">new-${bulletIndex}</span>
      <button type="button" class="btn-danger" onclick="removeBullet(this)">Remove</button>
    </div>
    <div class="field">
      <input type="hidden" name="id_new_${bulletIndex}" value="bullet-${bulletIndex}">
      <textarea name="text_new_${bulletIndex}" rows="2" required></textarea>
    </div>
    <div class="field-row">
      <div class="field">
        <label>Strength</label>
        <select name="strength_new_${bulletIndex}">
          <option value="high">High</option>
          <option value="medium" selected>Medium</option>
          <option value="supporting">Supporting</option>
        </select>
      </div>
      <div class="field">
        <label>Themes (comma-separated)</label>
        <input type="text" name="themes_new_${bulletIndex}" placeholder="e.g. data, api">
      </div>
    </div>
  `;
  container.appendChild(div);
  document.getElementById('bullet_count').value = bulletIndex;
}

function removeBullet(btn) {
  const card = btn.closest('.bullet-card');
  card.style.display = 'none';
  // Add hidden field to mark for removal
  const idx = bulletIndex++;
  const hidden = document.createElement('input');
  hidden.type = 'hidden';
  hidden.name = 'remove_' + card.dataset.index;
  hidden.value = 'true';
  document.getElementById('bullet-form').appendChild(hidden);
}
</script>

</body>
</html>