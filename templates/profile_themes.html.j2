<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profile — Edit Themes</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231e293b'/><rect x='8' y='13' width='16' height='11' rx='2' fill='%2322c55e'/><rect x='12' y='10' width='8' height='5' rx='1.5' fill='none' stroke='%2322c55e' stroke-width='2'/><rect x='15' y='17' width='2' height='3' rx='1' fill='%231e293b'/></svg>">
<style>
  :root { --blue: #3b82f6; --gray: #6b7280; --light: #f9fafb;
           --border: #e5e7eb; --text: #111827; --radius: 8px; --red: #ef4444; --green: #22c55e; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
         background: var(--light); color: var(--text); font-size: 14px; }
  .header { background: #1e293b; color: white; padding: 12px 20px;
            display: flex; align-items: center; gap: 16px; }
  .header a { color: #94a3b8; text-decoration: none; font-size: 13px; }
  .header a:hover { color: white; }
  .header h1 { font-size: 15px; font-weight: 600; }
  .main { max-width: 720px; margin: 0 auto; padding: 24px 20px; }
  h2 { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
  p.sub { font-size: 13px; color: var(--gray); margin-bottom: 20px; }
  .theme-card { background: white; border: 1px solid var(--border);
                border-radius: var(--radius); padding: 16px 20px; margin-bottom: 12px; }
  .theme-card h3 { font-size: 14px; margin-bottom: 8px; }
  .field { margin-bottom: 10px; }
  .field label { display: block; font-size: 11px; font-weight: 600;
                 color: #374151; margin-bottom: 3px; }
  .field input, .field textarea { width: 100%; padding: 7px 9px;
    border: 1px solid var(--border); border-radius: 4px; font-size: 13px;
    font-family: inherit; outline: none; }
  .field input:focus, .field textarea:focus { border-color: var(--blue); }
  .field textarea { min-height: 50px; resize: vertical; }
  .add-btn { background: none; border: 1px dashed var(--border); color: var(--blue);
             border-radius: 6px; padding: 10px 20px; font-size: 13px; cursor: pointer;
             width: 100%; margin-bottom: 12px; }
  .add-btn:hover { background: #f9fafb; border-color: var(--blue); }
  .remove-btn { background: none; border: 1px solid #fecaca; color: #991b1b;
                border-radius: 4px; padding: 4px 10px; font-size: 11px; cursor: pointer; }
  .remove-btn:hover { background: #fef2f2; }
  .success-banner { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px;
                    padding: 10px 16px; margin-bottom: 16px; font-size: 13px; color: #166534; }
  .actions { display: flex; gap: 12px; margin-top: 20px; }
  .btn-primary { background: #1e293b; color: white; border: none; border-radius: 6px;
                 padding: 10px 24px; font-size: 14px; font-weight: 500; cursor: pointer; }
  .btn-primary:hover { background: #334155; }
  .btn-secondary { background: white; color: #374151; border: 1px solid var(--border);
                   border-radius: 6px; padding: 10px 24px; font-size: 14px;
                   font-weight: 500; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn-secondary:hover { background: #f9fafb; }
</style>
</head>
<body>

<div class="header">
  <a href="/profile">← Back to Profile</a>
  <h1>Edit Themes</h1>
</div>

<div class="main">

  <h2>Summary Themes</h2>
  <p class="sub">
    Each theme generates a summary variant that appears on matched job cards.
    You can have up to 7 themes.
  </p>

  {% if saved %}
  <div class="success-banner">Saved successfully ✓</div>
  {% endif %}

  <form method="POST" action="/profile/themes" id="theme-form">

    <div id="theme-list">
    {% for theme in themes %}
      <div class="theme-card" data-index="{{ loop.index0 }}">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <h3>Theme {{ loop.index }}</h3>
          {% if themes|length > 1 %}
          <button type="button" class="remove-btn" onclick="removeTheme(this)">Remove</button>
          {% endif %}
        </div>
        <div class="field">
          <label>Label</label>
          <input type="text" name="label_{{ loop.index0 }}" value="{{ theme.label }}" required>
        </div>
        <div class="field">
          <label>Summary (2-3 sentences)</label>
          <textarea name="summary_{{ loop.index0 }}" rows="3">{{ theme.summary }}</textarea>
        </div>
      </div>
    {% endfor %}
    </div>

    {% if themes|length < 7 %}
    <button type="button" class="add-btn" onclick="addTheme()">+ Add a theme</button>
    {% endif %}

    <input type="hidden" name="theme_count" id="theme_count" value="{{ themes|length }}">
    <input type="hidden" name="removed" id="removed" value="">

    <div class="actions">
      <a href="/profile" class="btn-secondary">Cancel</a>
      <button type="submit" class="btn-primary">Save changes</button>
    </div>

  </form>

</div>

<script>
let themeIndex = {{ themes|length }};

function addTheme() {
  themeIndex++;
  const container = document.getElementById('theme-list');
  const div = document.createElement('div');
  div.className = 'theme-card';
  div.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
      <h3>Theme New</h3>
      <button type="button" class="remove-btn" onclick="removeTheme(this)">Remove</button>
    </div>
    <div class="field">
      <label>Label</label>
      <input type="text" name="label_new_${themeIndex}" required>
    </div>
    <div class="field">
      <label>Summary (2-3 sentences)</label>
      <textarea name="summary_new_${themeIndex}" rows="3"></textarea>
    </div>
  `;
  container.appendChild(div);
  document.getElementById('theme_count').value = themeIndex;
  // Hide add button if at max
  if (document.querySelectorAll('.theme-card').length >= 7) {
    event.target.style.display = 'none';
  }
}

function removeTheme(btn) {
  const card = btn.closest('.theme-card');
  card.style.display = 'none';
  // Track removed via hidden field
  const removed = document.getElementById('removed');
  removed.value = removed.value + ',' + themeIndex;
  themeIndex++;
}
</script>

</body>
</html>