<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ prompt_label or 'Tailor' }} — {{ job.title }} at {{ job.company }}</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231e293b'/><rect x='8' y='13' width='16' height='11' rx='2' fill='%2322c55e'/><rect x='12' y='10' width='8' height='5' rx='1.5' fill='none' stroke='%2322c55e' stroke-width='2'/><rect x='15' y='17' width='2' height='3' rx='1' fill='%231e293b'/></svg>">
<style>
  :root {
    --blue: #3b82f6; --gray: #6b7280; --light: #f9fafb;
    --border: #e5e7eb; --text: #111827; --radius: 8px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
         background: var(--light); color: var(--text); font-size: 14px; }

  .header { background: #1e293b; color: white; padding: 12px 20px;
            display: flex; align-items: center; gap: 16px; }
  .header a { color: #94a3b8; text-decoration: none; font-size: 13px; }
  .header a:hover { color: white; }
  .header h1 { font-size: 15px; font-weight: 600; }

  .main { max-width: 860px; margin: 0 auto; padding: 24px 20px; }

  .job-meta { margin-bottom: 20px; }
  .job-meta h2 { font-size: 18px; font-weight: 700; }
  .job-meta .sub { font-size: 13px; color: var(--gray); margin-top: 4px; }
  .job-meta .sub a { color: var(--blue); text-decoration: none; }
  .job-meta .sub a:hover { text-decoration: underline; }

  .section-label { font-size: 11px; font-weight: 600; text-transform: uppercase;
                   letter-spacing: .5px; color: var(--gray); margin-bottom: 8px; }

  .prompt-box { position: relative; margin-bottom: 24px; }
  textarea {
    width: 100%; min-height: 520px; padding: 16px;
    border: 1px solid var(--border); border-radius: var(--radius);
    font-family: "SF Mono", "Fira Code", monospace; font-size: 12px;
    line-height: 1.6; resize: vertical; background: white; color: var(--text);
    outline: none;
  }
  textarea:focus { border-color: var(--blue); }

  .copy-bar { display: flex; align-items: center; gap: 12px; margin-top: 10px; }
  .btn-copy {
    background: #1e293b; color: white; border: none; border-radius: 6px;
    padding: 8px 20px; font-size: 13px; font-weight: 500; cursor: pointer;
  }
  .btn-copy:hover { background: #334155; }
  .copy-confirm { font-size: 12px; color: #16a34a; display: none; }
  .btn-apply {
    background: #16a34a; color: white; border: none; border-radius: 6px;
    padding: 8px 20px; font-size: 13px; font-weight: 500; cursor: pointer;
  }
  .btn-apply:hover { background: #15803d; }
  .applied-badge { font-size: 13px; color: #16a34a; font-weight: 600; }

  .hint { font-size: 12px; color: var(--gray); line-height: 1.5; }
  .hint a { color: var(--blue); }
</style>
</head>
<body>

<div class="header">
  <a href="{{ '/?view=manual' if job.site == 'manual' else '/' }}">← Back</a>
  <h1>{{ prompt_label or 'Tailor' }} prompt — {{ job.title }} at {{ job.company }}</h1>
</div>

<div class="main">

  <div class="job-meta">
    <h2>{{ job.title }}</h2>
    <div class="sub">
      {{ job.company }}
      {% if job.location %} &nbsp;·&nbsp; {{ job.location }}{% endif %}
      {% if job.is_remote %} &nbsp;·&nbsp; Remote{% endif %}
      &nbsp;·&nbsp; <a href="{{ job.url }}" target="_blank">View posting ↗</a>
    </div>
  </div>

  <div class="section-label">Ready-to-paste prompt</div>
  <div class="prompt-box">
    <textarea id="prompt-text" readonly>{{ prompt }}</textarea>
  </div>

  <div class="copy-bar">
    <button class="btn-copy" onclick="copyPrompt()">Copy prompt</button>
    <span class="copy-confirm" id="copy-confirm">Copied to clipboard ✓</span>
    {% if job.status == 'applied' %}
      <span class="applied-badge">Applied ✓</span>
    {% else %}
      <form method="POST" action="/job/{{ job.id }}/status" style="display:inline">
        <input type="hidden" name="status" value="applied">
        <button type="submit" class="btn-apply">Mark as applied ✓</button>
      </form>
    {% endif %}
  </div>

  <p class="hint" style="margin-top:16px">
    Paste this into your LLM of choice.
    {% if job.recommended_summary %}Recommended summary variant: <strong>{{ job.recommended_summary }}</strong>.{% endif %}
  </p>

</div>

<script>
function copyPrompt() {
  const ta = document.getElementById('prompt-text');
  ta.select();
  ta.setSelectionRange(0, 99999);
  navigator.clipboard.writeText(ta.value).then(() => {
    const el = document.getElementById('copy-confirm');
    el.style.display = 'inline';
    setTimeout(() => el.style.display = 'none', 2000);
  });
}
</script>
</body>
</html>
